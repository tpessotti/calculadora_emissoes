# ============================================================
# Calculadora de Emissões — environment configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ----- Core Django -----
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ----- Database (leave blank to use SQLite in development) -----
# DATABASE_URL=postgres://user:password@localhost:5432/calculadora_emissoes

# ----- Redis (Celery broker + Django cache) -----
REDIS_URL=redis://localhost:6379/0

# ----- Celery -----
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ----- Email (optional, used for password reset) -----
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=user@example.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@example.com

# ----- Encryption key for chatbot API keys (Fernet) -----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# ----- OpenRouter (default fallback key — users can set their own) -----
# OPENROUTER_API_KEY=

# ----- Static / Media files -----
# STATIC_ROOT=/var/www/calculadora/static
# MEDIA_ROOT=/var/www/calculadora/media
# MEDIA_URL=/media/

# ----- Security headers (production only) -----
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# HSTS_SECONDS=31536000
